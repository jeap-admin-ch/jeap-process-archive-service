<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <url>https://github.com/jeap-admin-ch/jeap-process-archive-service/tree/main</url>
    <scm>
        <url>https://github.com/jeap-admin-ch/jeap-process-archive-service/tree/master.git</url>
        <connection>scm:git:git://github.com/jeap-admin-ch/jeap-process-archive-service.git</connection>
        <developerConnection>scm:git:ssh://github.com:jeap-admin-ch/jeap-process-archive-service.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <name>BIT</name>
            <email>jeap-community@bit.admin.ch</email>
            <organization>Federal Office of Information Technology, Systems and Telecommunication FOITT</organization>
            <organizationUrl>https://www.bit.admin.ch/</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <version>41.7.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <artifactId>jeap-process-archive-service-parent</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <version>24.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>JEAP Process Archive Service</description>

    <properties>
        <jeap-process-archive-reader.version>9.3.0</jeap-process-archive-reader.version>
        <avro-maven-plugin.version>1.12.2</avro-maven-plugin.version>
        <jackson-coreutils.version>2.0</jackson-coreutils.version>
        <checker-qual.version>4.2.3</checker-qual.version>

        <shared-archived-artifact-version-created-event.version>2.0.2</shared-archived-artifact-version-created-event.version>
        <create-artifact-command.version>1.0.1</create-artifact-command.version>
        <maven.javadoc.skip>false</maven.javadoc.skip>
    </properties>

    <modules>
        <module>jeap-process-archive-adapter-objectstorage</module>
        <module>jeap-process-archive-adapter-kafka</module>
        <module>jeap-process-archive-adapter-db</module>
        <module>jeap-process-archive-adapter-kafka-test</module>
        <module>jeap-process-archive-config-repository</module>
        <module>jeap-process-archive-config-type-repository</module>
        <module>jeap-process-archive-domain</module>
        <module>jeap-process-archive-plugin-api</module>
        <module>jeap-process-archive-remote-data-provider</module>
        <module>jeap-process-archive-service</module>
        <module>jeap-process-archive-type-registry-maven-plugin</module>
        <module>jeap-process-archive-avro-maven-plugin</module>
        <module>jeap-process-archive-avro-validator</module>
        <module>jeap-process-archive-type-registry</module>
        <module>jeap-process-archive-web</module>
        <module>jeap-process-archive-adapter-crypto</module>
        <module>jeap-process-archive-service-instance</module>
        <module>jeap-process-archive-test-types</module>
        <module>jeap-process-archive-service-config-only-it</module>
        <module>jeap-process-archive-adapter-rest-api</module>
        <module>jeap-process-archive-adapter-opensearch</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-domain</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-type-registry</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-adapter-crypto</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-config-repository</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-config-type-repository</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-adapter-kafka</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-adapter-db</artifactId>
                <version>24.3.0-SNAPSHOT</version>
                <optional>true</optional>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-plugin-api</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-avro-validator</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-adapter-objectstorage</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-remote-data-provider</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-web</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-service</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-adapter-rest-api</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-adapter-opensearch</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-service-instance</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-test-types</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-process-archive-adapter-kafka-test</artifactId>
                <version>24.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>org.apache.maven.plugin-testing</groupId>
                <artifactId>maven-plugin-testing-harness</artifactId>
                <version>${maven-plugin-testing-harness.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-container-default</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Add license entry to jar manifest -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Bundle-License>https://www.apache.org/licenses/LICENSE-2.0</Bundle-License>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>${maven-plugin-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <!-- prevent the plugin from failing the build when it encounters errors in javadoc comments
                         (which sometimes seems to happen in message type classes created from avro) -->
                    <configuration>
                        <failOnError>false</failOnError>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
          </plugins>
        </pluginManagement>
        <plugins>
            <!-- Check third-party license compliance -->
            <plugin>
                <groupId>org.honton.chas</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
            <!-- Generate third-party license list -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
